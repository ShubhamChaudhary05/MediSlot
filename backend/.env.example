# Copy this file to .env and fill values from Supabase Project Settings > Database.
# Do not commit the resulting .env file. The JDBC URL must begin with jdbc:postgresql://.
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_SUPABASE_USERNAME
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# Generate at least 32 random bytes and Base64 encode them, for example:
# [Convert]::ToBase64String((1..32 | %% { Get-Random -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_SECRET
JWT_ACCESS_TOKEN_MINUTES=30
PASSWORD_RESET_MINUTES=15
PASSWORD_RESET_MAX_REQUESTS=3
FRONTEND_ORIGIN=http://localhost:3000

# Optional. There is intentionally no public administrator registration endpoint.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Platform Administrator

# Set MAIL_MODE=smtp and populate these values in production. For safe local testing,
# set MAIL_MODE=development-file; reset links are written to the ignored .dev-reset-emails directory.
MAIL_MODE=disabled
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
